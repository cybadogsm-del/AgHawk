[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "REPLACE_IN_LOCAL_SECRETS" # pragma: allowlist secret

[auth.auth0]
client_id = "REPLACE_IN_LOCAL_SECRETS" # pragma: allowlist secret
client_secret = "REPLACE_IN_LOCAL_SECRETS" # pragma: allowlist secret
server_metadata_url = "https://YOUR_AUTH0_DOMAIN/.well-known/openid-configuration"
client_kwargs = { "prompt" = "login" }
